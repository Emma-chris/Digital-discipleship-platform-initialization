# ---------------------------------------------------------------------------
# DisciplePath Platform — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000

# PostgreSQL (Neon or any PostgreSQL 14+). Example (Neon):
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Server-side session signing secret — generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Signing secret for short-lived JWTs (email verification, password reset, API tokens)
JWT_SECRET=

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Extra CORS origins (comma-separated). Added to APP_URL and API_URL.
# Example for a Vercel frontend:
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=